# Arquivos de configuração sensíveis
/src/main/resources/application.properties
.env

# Diretório de build do Maven
target/

# Exceções para arquivos específicos dentro de src/main e src/test
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

